NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


INTERNAL_ADMIN_EMAILS=


# Credenciais globais do SaaS, usadas para cobrar planos das clinicas.
# Recebimento de sinal das clinicas fica em Dashboard > Configuracoes > Integracoes.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=NexaWi-Clinicas/1.0

# Chave longa usada para criptografar credenciais individuais das clínicas.
CLINICA_SECRETS_KEY=
APP_URL=http://localhost:3000
CRON_SECRET=


APP_PRIMARY_HOSTS=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=


# Credencial global da plataforma para envio de e-mail transacional.
# Use um endereço pertencente ao domínio ou subdomínio verificado no Resend.
# Cada clínica configura apenas o destinatário operacional em Dashboard > Configurações > Integrações.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NexaWi Clínicas <agendamentos@notificacoes.nexawi.com.br>


# Credencial global do SaaS para buscar avaliacoes reais do Google Places.
# Cada clinica informa o Place ID em Dashboard > Configuracoes > Depoimentos.
GOOGLE_MAPS_API_KEY=

# WhatsApp Business Platform oficial (Meta Cloud API / Tech Provider).
# Todas são credenciais centrais da NexaWi e devem existir somente no servidor.
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_WHATSAPP_CONFIG_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_INTERACTION_TOKEN_SECRET=
